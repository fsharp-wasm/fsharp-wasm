<Project>
  <!-- Global defaults for first-party projects (applies repo-wide) -->
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <LangVersion Condition="'$(LangVersion)' == ''">preview</LangVersion>
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>

  <!-- FSharp.Wasm.Core, the F# base library programs are compiled with: the `core` submodule (repository fsharp-wasm-core).
       FSHARP_WASM_CORE_DIR points at another checkout of it. -->
  <PropertyGroup>
    <FSharpWasmCoreDir Condition="'$(FSharpWasmCoreDir)' == '' and '$(FSHARP_WASM_CORE_DIR)' != ''">$(FSHARP_WASM_CORE_DIR)/FSharp.Wasm.Core</FSharpWasmCoreDir>
    <FSharpWasmCoreDir Condition="'$(FSharpWasmCoreDir)' == ''">$(MSBuildThisFileDirectory)core/FSharp.Wasm.Core</FSharpWasmCoreDir>
  </PropertyGroup>

  <PropertyGroup>
    <FableCoreOnly>true</FableCoreOnly>
    <DefineConstants>$(DefineConstants);FABLE_CORE_ONLY</DefineConstants>

    <FableCoreNet10>true</FableCoreNet10>
    <DefineConstants>$(DefineConstants);FABLE_CORE_NET10</DefineConstants>

    <FableCoreVersion>net10.0</FableCoreVersion>

    <FSharpNetCoreProductTargetFramework>net10.0</FSharpNetCoreProductTargetFramework>
  </PropertyGroup>

  <!--
    Patched F# compiler support.

    When FSHARP_COMPILER env var is set (done by .envrc when the binary exists),
    override FscToolPath to use the patched fsc.dll from vendor/fsharp.

    To build the patched compiler (needs the SDK band from vendor/fsharp/global.json; CI uses 10.0.303):
      cd vendor/fsharp
      ./build/build.sh -c Release

    FSHARP_COMPILER is set to:
      vendor/fsharp/artifacts/bin/fsc/Release/net10.0/fsc.dll
  -->
  <PropertyGroup Condition="'$(FSHARP_COMPILER)' != ''">
    <!-- <FscToolPath>$([System.IO.Path]::GetDirectoryName('$(FSHARP_COMPILER)'))</FscToolPath> -->
    <!-- <FscToolExe>fsc.dll</FscToolExe> -->
    <!-- Override the dotnet fsc compiler path with the patched version. -->
    <!-- The standard SDK uses DotnetFscCompilerPath for managed (dotnet) fsc invocations. -->
    <DotnetFscCompilerPath>$(FSHARP_COMPILER)</DotnetFscCompilerPath>
    <FSharpWasmGC Condition="'$(FSharpWasmGC)' == ''">$(MSBuildThisFileDirectory)</FSharpWasmGC>
  </PropertyGroup>
</Project>
