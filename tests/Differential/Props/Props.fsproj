<Project Sdk="Microsoft.NET.Sdk">
  <!-- Properties for the differential test: total functions over int / float / bool, run with generated inputs on
       .NET (reference) and as wasm.  Both builds compile THIS project, so they cannot drift apart. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188;FS0988</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(FSharpWasmCoreDir)/Interop.fs" />
    <Compile Include="Props.fs" />
    <Compile Include="PropsStrings.fs" />
    <Compile Include="PropsInt64.fs" />
    <Compile Include="PropsData.fs" />
    <Compile Include="PropsLists.fs" />
    <Compile Include="PropsGenerics.fs" />
    <Compile Include="PropsFormat.fs" />
  </ItemGroup>
</Project>
