<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fable.Core stubs: [<Import>] and nativeOnly -->
    <Compile Include="$(FSharpWasmCoreDir)/Interop.fs" />
    <Compile Include="HostInterop.fs" />
  </ItemGroup>

</Project>
