<Project Sdk="Microsoft.NET.Sdk">
  <!-- The wasm build of Bench.fs (without the .NET-only Program.fs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188;FS0988;FS3370</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(FSharpWasmCoreDir)/Interop.fs" />
    <Compile Include="../Bench.fs" />
  </ItemGroup>
</Project>
