<Project Sdk="Microsoft.NET.Sdk">
  <!-- The same Bench.fs is compiled to wasm by the backend (tools/FSharp.Wasm.Cli) and as .NET (this project). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188;FS0988;FS3370</NoWarn>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(FSharpWasmCoreDir)/Interop.fs" />
    <Compile Include="Bench.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
