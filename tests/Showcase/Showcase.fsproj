<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      WasmGC Showcase — real-world F# demonstrating compiler capabilities.
      Compiled by the Fable WasmGC backend to a single .wasm binary.
    -->
    <Compile Include="../../fable-library-wasmgc/Core/Interop.fs" />
    <Compile Include="Showcase.fs" />
  </ItemGroup>

</Project>
