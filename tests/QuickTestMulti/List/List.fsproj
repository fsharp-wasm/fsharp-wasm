<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Standalone domain project: List (74 tests).
    Compile with:  dotnet fable Multi/List.fsproj \-\-lang wasmgc
    Link with others: use Linker.linkModules in the build script.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <AssemblyName>QuickTest.List</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(FSharpWasmCoreDir)/Interop.fs" />
    <Compile Include="../Preamble.fs" />
    <Compile Include="../TestsList.fs" />
  </ItemGroup>
</Project>
