<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Strings across the host boundary without the JS String Builtins (WASMGC_STRING_ABI=exports): see run.sh -->
    <Compile Include="$(FSharpWasmCoreDir)/Interop.fs" />
    <Compile Include="StringAbi.fs" />
  </ItemGroup>

</Project>
