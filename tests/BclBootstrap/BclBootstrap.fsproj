<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fable.Core stubs (Import attribute, nativeOnly) -->
    <Compile Include="$(FSharpWasmCoreDir)/Interop.fs" />
    <!-- BCL bootstrap: Exception hierarchy + Math -->
    <Compile Include="$(FSharpWasmCoreDir)/Exception.fs" />
    <Compile Include="$(FSharpWasmCoreDir)/Math.fs" />
    <!-- Test driver -->
    <Compile Include="BclBootstrapTests.fs" />
  </ItemGroup>

</Project>
